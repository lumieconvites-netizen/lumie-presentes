generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== AUTENTICAÇÃO =====

model User {
  id                     String            @id @default(cuid())
  name                   String?
  email                  String            @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  role                   UserRole          @default(CLIENT)
  isBlocked              Boolean           @default(false)
  blockReason            String?
  blockedAt              DateTime?
  partnerAmbassadorId    String?
  referredByPartnerId    String?
  referredByAmbassadorId String?
  acquisitionSource      AcquisitionSource @default(PLATFORM_DIRECT)
  appliedReferralCode    String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  giftLists                   GiftList[]
  recipient                   Recipient?
  partnerAmbassador           User?          @relation("PartnerToAmbassador", fields: [partnerAmbassadorId], references: [id], onDelete: SetNull)
  partnerReferrals            User[]         @relation("PartnerToAmbassador")
  referredByPartner           User?          @relation("PartnerToClient", fields: [referredByPartnerId], references: [id], onDelete: SetNull)
  referredClientsAsPartner    User[]         @relation("PartnerToClient")
  referredByAmbassador        User?          @relation("AmbassadorToClient", fields: [referredByAmbassadorId], references: [id], onDelete: SetNull)
  referredClientsAsAmbassador User[]         @relation("AmbassadorToClient")
  referralCodes               ReferralCode[]

  @@index([role])
  @@index([role, createdAt])
  @@index([isBlocked, createdAt])
  @@index([partnerAmbassadorId])
  @@index([referredByPartnerId])
  @@index([referredByAmbassadorId])
  @@index([appliedReferralCode])
  @@map("users")
}

model EmailVerificationCode {
  id            String              @id @default(cuid())
  email         String
  code          String
  purpose       VerificationPurpose
  name          String?
  passwordHash  String?
  templateSlug  String?
  requestedRole UserRole            @default(CLIENT)
  inviteCode    String?
  expiresAt     DateTime
  usedAt        DateTime?
  attempts      Int                 @default(0)
  createdAt     DateTime            @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

enum VerificationPurpose {
  REGISTER
}

enum UserRole {
  CLIENT
  PARTNER
  AMBASSADOR
  EMPLOYEE
  ADMIN
}

enum AcquisitionSource {
  PLATFORM_DIRECT
  AMBASSADOR_DIRECT
  PARTNER_DIRECT
  PARTNER_WITH_AMBASSADOR
}

model ReferralCode {
  id          String           @id @default(cuid())
  ownerUserId String
  code        String           @unique
  type        ReferralCodeType
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([ownerUserId, isActive])
  @@index([type])
  @@map("referral_codes")
}

enum ReferralCodeType {
  PARTNER_CLIENT
  AMBASSADOR_CLIENT
  AMBASSADOR_PARTNER
}

// ===== LISTA DE PRESENTES =====

model GiftList {
  id               String    @id @default(cuid())
  userId           String
  slug             String    @unique
  title            String
  description      String?
  giftsPageCoverImageUrl String?
  eventDate        DateTime?
  isPublished      Boolean   @default(false)
  templateId       String?
  feeMode          FeeMode   @default(PASS_TO_GUEST)
  allowMessages    Boolean   @default(true)
  allowPhotoUpload Boolean   @default(true)
  showGuestNames   Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     Template?     @relation(fields: [templateId], references: [id])
  pageLayout   PageLayout?
  gifts        GiftItem[]
  orders       Order[]
  messages     Message[]
  rsvpSettings RsvpSettings?
  rsvpGuests   RsvpGuest[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([slug])
  @@index([isPublished, createdAt])
  @@map("gift_lists")
}

enum FeeMode {
  PASS_TO_GUEST
  ABSORB
}

// ===== LAYOUT DA PÁGINA =====

model PageLayout {
  id         String   @id @default(cuid())
  giftListId String   @unique
  blocks     Json
  theme      Json
  customCss  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  giftList GiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)

  @@map("page_layouts")
}

// ===== PRESENTES =====

model GiftItem {
  id            String   @id @default(cuid())
  giftListId    String
  name          String
  description   String?
  imageUrl      String?
  basePrice     Decimal  @db.Decimal(10, 2)
  totalQuantity Int      @default(1)
  availableQty  Int      @default(1)
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  giftList GiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([giftListId])
  @@index([giftListId, order])
  @@index([giftListId, isActive])
  @@index([isActive])
  @@map("gift_items")
}

// ===== PEDIDOS/TRANSAÇÕES =====

model Order {
  id              String      @id @default(cuid())
  giftListId      String
  giftItemId      String
  guestName       String
  guestEmail      String?
  quantity        Int         @default(1)
  baseAmount      Decimal     @db.Decimal(10, 2)
  feeAmount       Decimal     @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  paymentMethod   String?
  pagarmeOrderId  String?     @unique
  pagarmeChargeId String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  giftList GiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)
  giftItem GiftItem @relation(fields: [giftItemId], references: [id])

  // ✅ deixa explícito para evitar ambiguidade
  message Message? @relation("OrderToMessage")

  webhookEvents WebhookEvent[]

  @@index([giftListId])
  @@index([status, createdAt])
  @@index([paymentMethod, createdAt])
  @@index([giftListId, status, createdAt])
  @@index([paidAt])
  @@index([pagarmeOrderId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  AUTHORIZED
  REFUSED
  REFUNDED
  CHARGEBACK
}

// ===== RECADOS =====

model Message {
  id         String   @id @default(cuid())
  orderId    String   @unique
  giftListId String
  guestName  String
  content    String   @db.Text
  signature  String?
  photoUrls  Json?
  isPublic   Boolean  @default(true)
  isFavorite Boolean  @default(false)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ✅ mesmo nome da relation do Order
  order    Order    @relation("OrderToMessage", fields: [orderId], references: [id], onDelete: Cascade)
  giftList GiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)

  @@index([giftListId])
  @@index([giftListId, createdAt])
  @@index([giftListId, isPublic, createdAt])
  @@index([isPublic])
  @@map("messages")
}

// ===== PAGAR.ME =====

model Recipient {
  id                 String   @id @default(cuid())
  userId             String   @unique
  pagarmeRecipientId String   @unique
  bankAccount        Json
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recipients")
}

model WebhookEvent {
  id        String   @id @default(cuid())
  orderId   String?
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])

  @@index([eventType])
  @@index([processed])
  @@index([processed, createdAt])
  @@map("webhook_events")
}

model AccountRetentionAuditLog {
  id        String   @id @default(cuid())
  runId     String
  dryRun    Boolean  @default(false)
  action    String
  userId    String?
  userEmail String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("account_retention_audit_logs")
}

// ===== TEMPLATES =====

model Template {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  category      String
  thumbnail     String?
  defaultBlocks Json
  defaultTheme  Json
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  giftLists GiftList[]

  @@map("templates")
}

// ===== RSVP =====

model RsvpSettings {
  id                String   @id @default(cuid())
  giftListId        String   @unique
  enabled           Boolean  @default(false)
  notificationEmail String?
  eventTitle        String?
  eventDateLabel    String?
  eventLocation     String?
  coverImageUrl     String?
  publicTitle       String?
  publicDescription String?
  searchPlaceholder String?
  checkInEnabled    Boolean  @default(true)
  checkInSlug       String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  giftList GiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)

  @@map("rsvp_settings")
}

model RsvpGuest {
  id                String     @id @default(cuid())
  giftListId        String
  fullName          String
  email             String?
  phone             String?
  notes             String?
  adultLimit        Int        @default(0)
  childLimit        Int        @default(0)
  confirmedAdults   Int?
  confirmedChildren Int?
  status            RsvpStatus @default(PENDING)
  qrToken           String     @unique
  confirmedAt       DateTime?
  checkedInAt       DateTime?
  checkInCode       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  giftList GiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)

  @@index([giftListId])
  @@index([status])
  @@index([fullName])
  @@index([giftListId, fullName])
  @@index([giftListId, status, createdAt])
  @@map("rsvp_guests")
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}
